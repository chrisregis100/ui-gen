{
  "name": "ui-gen",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered React, TypeScript, and Tailwind component generator.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "build": "pnpm --filter @ui-gen/core build && pnpm --filter @ui-gen/cli --filter @ui-gen/mcp build && pnpm --filter web build",
    "test": "vitest run",
    "typecheck": "pnpm build",
    "ui-gen": "node packages/cli/dist/index.js",
    "ui-gen-mcp": "node packages/mcp/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
